# Copy to .env.local for local testing. On Vercel, add the same names under Settings > Environment Variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_VAPID_PUBLIC_KEY=see KEYS-private.txt
# server only, never starts with VITE_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VAPID_PRIVATE_KEY=see KEYS-private.txt
VAPID_SUBJECT=mailto:you@email.com
CRON_SECRET=see KEYS-private.txt
# after the first TestFlight build: the public TestFlight link, so iPhone invites point to the app
VITE_TESTFLIGHT_URL=
